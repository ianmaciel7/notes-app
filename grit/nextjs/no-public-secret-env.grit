engine biome(1.0)
language js(typescript, jsx)

JsStaticMemberExpression(object=$env, member=$member) as $access where {
  $env <: `process.env`,
  $member <: r"^NEXT_PUBLIC_.*(?:SECRET|TOKEN|PASSWORD|PRIVATE|API_KEY|KEY).*$",
  register_diagnostic(span=$access, message="Do not expose secret-like values through NEXT_PUBLIC_*. NEXT_PUBLIC_ variables are bundled for the browser.")
}
