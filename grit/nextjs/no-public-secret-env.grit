engine biome(1.0)
language js(typescript, jsx)

JsStaticMemberExpression() as $access where {
  $access <: r"^process\.env\.NEXT_PUBLIC_.*(?:SECRET|TOKEN|PASSWORD|PRIVATE|API_KEY|KEY).*$",
  register_diagnostic(span=$access, message="Do not expose secret-like values through NEXT_PUBLIC_*. NEXT_PUBLIC_ variables are bundled for the browser.")
}
