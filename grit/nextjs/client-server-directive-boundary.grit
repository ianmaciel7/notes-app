engine biome(1.0)
language js(typescript, jsx)

JsDirectiveList() as $directives where {
  $directives <: contains `"use client"`,
  $directives <: contains JsDirective() as $directive where {
    $directive <: r".*use (?:server|cache(?:: (?:private|remote))?).*"
  },
  register_diagnostic(
    span=$directives,
    message="Do not mix client and server/cache directives in the same module. Keep the client boundary small and move server or cache work to a separate server module."
  )
}
