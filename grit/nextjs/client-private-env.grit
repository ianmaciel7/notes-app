engine biome(1.0)
language js(typescript, jsx)

or {
  JsStaticMemberExpression(object=$env, member=$member) as $access where {
    $env <: `process.env`,
    $access <: within JsModule() as $module where {
      $module <: contains `"use client"`
    },
    not $member <: r"NEXT_PUBLIC_.*",
    register_diagnostic(
      span=$access,
      message="Private environment variables must not be read from a Client Component entry module. Keep secrets server-only; only NEXT_PUBLIC_* values are intentionally exposed to the browser."
    )
  },
  JsComputedMemberExpression(object=$env) as $access where {
    $env <: `process.env`,
    $access <: within JsModule() as $module where {
      $module <: contains `"use client"`
    },
    register_diagnostic(
      span=$access,
      message="Dynamic environment-variable access is not allowed in a Client Component entry module. Keep secrets server-only and use statically referenced NEXT_PUBLIC_* variables only for intentional browser exposure."
    )
  }
}
