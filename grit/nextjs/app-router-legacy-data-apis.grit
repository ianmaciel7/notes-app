engine biome(1.0)
language js(typescript, jsx)

or {
  JsFunctionDeclaration(id=$name) as $node,
  JsVariableDeclarator(id=$name) as $node,
  JsMethodClassMember(name=$name) as $node
} where {
  $name <: r"(?:getServerSideProps|getStaticProps|getStaticPaths|getInitialProps)",
  register_diagnostic(
    span=$node,
    message="Pages Router data APIs are not part of this App Router architecture. Fetch data in Server Components, use generateStaticParams for dynamic prerendering, and use the App Router cache/revalidation APIs."
  )
}
