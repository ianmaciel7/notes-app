engine biome(1.0)
language js(typescript, jsx)

JsPropertyObjectMember(name=$name, value=$value) as $property where {
  $name <: r"^ignoreBuildErrors$",
  $value <: `true`,
  $property <: within JsObjectExpression() as $object,
  $object <: within JsPropertyObjectMember(name=$parent_name) where {
    $parent_name <: r"^typescript$"
  },
  register_diagnostic(span=$property, message="Do not set typescript.ignoreBuildErrors to true. Production builds must fail on TypeScript errors in this repository.")
}
