engine biome(1.0)
language js(typescript, jsx)

or {
  `redirect($target)` as $call,
  `permanentRedirect($target)` as $call
} where {
  $call <: within JsTryStatement() ,
  register_diagnostic(span=$call, message="Next.js redirect APIs throw framework-controlled errors. In this repository, call redirect/permanentRedirect outside try blocks so catch handlers cannot swallow navigation.")
}
