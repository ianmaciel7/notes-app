engine biome(1.0)
language js(typescript, jsx)

or {
  JsPropertyObjectMember(name=$name) as $legacy where {
    $name <: r"^(?:serverRuntimeConfig|publicRuntimeConfig)$"
  },
  `"next/config"` as $legacy
} where {
  register_diagnostic(span=$legacy, message="Next.js 16 removed runtime config and next/config. Use server environment variables directly and NEXT_PUBLIC_* only for values intentionally exposed to the browser.")
}
