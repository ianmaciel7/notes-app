engine biome(1.0)
language js(typescript, jsx)

JsPropertyObjectMember(name=$name, value=$value) as $property where {
  $name <: r"^ppr$",
  $value <: `true`,
  $property <: within JsObjectExpression() as $object,
  $object <: within JsPropertyObjectMember(name=$parent_name) where {
    $parent_name <: r"^experimental$"
  },
  register_diagnostic(span=$property, message="Do not carry experimental.ppr into this Next.js 16 project. Migrate deliberately to the Cache Components model instead of treating this as a rename-only configuration.")
}
