engine biome(1.0)
language js(typescript, jsx)

or {
  JsLiteralMemberName() as $target where { $target <: r"^ppr$" },
  `experimental_ppr` as $target
} where {
  register_diagnostic(span=$target, message="Next.js 16 replaced experimental.ppr and experimental_ppr segment configs with Cache Components (cacheComponents). Adopt the Cache Components model deliberately instead of carrying over experimental.ppr.")
}
