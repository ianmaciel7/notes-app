engine biome(1.0)
language js(typescript, jsx)

or {
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:DialogTrigger|DialogContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Dialog$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:DialogHeader|DialogFooter|DialogTitle|DialogDescription|DialogClose)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^DialogContent$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:SheetTrigger|SheetContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Sheet$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:SheetHeader|SheetFooter|SheetTitle|SheetDescription|SheetClose)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^SheetContent$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:DrawerTrigger|DrawerContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Drawer$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:DrawerHeader|DrawerFooter|DrawerTitle|DrawerDescription|DrawerClose)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^DrawerContent$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:AlertDialogTrigger|AlertDialogContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^AlertDialog$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:AlertDialogHeader|AlertDialogFooter|AlertDialogTitle|AlertDialogDescription|AlertDialogAction|AlertDialogCancel)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^AlertDialogContent$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:PopoverTrigger|PopoverContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Popover$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:HoverCardTrigger|HoverCardContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^HoverCard$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:TooltipTrigger|TooltipContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Tooltip$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:DropdownMenuTrigger|DropdownMenuContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^DropdownMenu$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:ContextMenuTrigger|ContextMenuContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^ContextMenu$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:CollapsibleTrigger|CollapsibleContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Collapsible$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:SelectTrigger|SelectContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Select$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$part_name) as $part,
    JsxOpeningElement(name=$part_name) as $part
  } where {
    $part_name <: r"(?:ComboboxTrigger|ComboboxContent)",
    not $part <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^Combobox$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  }
} where {
  register_diagnostic(span=$part, message="Invalid overlay/interactive compound-component nesting. Keep triggers, content, and structural parts under their shadcn owner primitive.")
}
