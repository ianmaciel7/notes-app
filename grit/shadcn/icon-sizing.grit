engine biome(1.0)
language js(typescript, jsx)

or {
  JsxSelfClosingElement(name=$icon_name, attributes=$attributes) as $icon,
  JsxOpeningElement(name=$icon_name, attributes=$attributes) as $icon
} where {
  $icon_name <: r"(?:[A-Za-z0-9]+Icon|Spinner)",
  $icon <: within JsxElement() as $parent where {
    $parent <: r"(?s)^<(?:Button|Badge|ItemMedia|MarkerIcon|InputGroupAddon)(?:\s|>)"
  } ,
  $attributes <: contains JsxAttribute() as $class_name,
  $class_name <: r"(?s)className(?:\s*=.*)?(?:\bsize-|\bw-|\bh-)",
  register_diagnostic(span=$class_name, message="Do not manually size icons inside components; components handle icon sizing via CSS.")
}
