engine biome(1.0)
language js(typescript,jsx)

or {
  JsxSelfClosingElement(name = $trigger_name) as $trigger,
  JsxOpeningElement(name = $trigger_name) as $trigger
} where {
  $trigger_name <: r"TabsTrigger",
  not $trigger <: within JsxElement(
    opening_element = JsxOpeningElement(name = $list_name)
  ),
  $list_name <: r"TabsList",
  register_diagnostic(
    span = $trigger,
    message = "TabsTrigger must be nested inside TabsList."
  )
}
