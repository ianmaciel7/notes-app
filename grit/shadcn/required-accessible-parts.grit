engine biome(1.0)
language js(typescript, jsx)

or {
  JsxElement(opening_element=JsxOpeningElement(name=$dialog_name), elements=$dialog_children) as $element where {
    $dialog_name <: r"DialogContent",
    not $dialog_children <: r"(?s).*<DialogTitle(\s|>).*",
    register_diagnostic(span=$element, message="DialogContent must contain DialogTitle. Use className=\"sr-only\" when the title should be visually hidden.")
  },
  JsxElement(opening_element=JsxOpeningElement(name=$sheet_name), elements=$sheet_children) as $element where {
    $sheet_name <: r"SheetContent",
    not $sheet_children <: r"(?s).*<SheetTitle(\s|>).*",
    register_diagnostic(span=$element, message="SheetContent must contain SheetTitle. Use className=\"sr-only\" when the title should be visually hidden.")
  },
  JsxElement(opening_element=JsxOpeningElement(name=$drawer_name), elements=$drawer_children) as $element where {
    $drawer_name <: r"DrawerContent",
    not $drawer_children <: r"(?s).*<DrawerTitle(\s|>).*",
    register_diagnostic(span=$element, message="DrawerContent must contain DrawerTitle. Use className=\"sr-only\" when the title should be visually hidden.")
  },
  JsxElement(opening_element=JsxOpeningElement(name=$avatar_name), elements=$avatar_children) as $element where {
    $avatar_name <: r"Avatar",
    not $avatar_children <: r"(?s).*<AvatarFallback(\s|>).*",
    register_diagnostic(span=$element, message="Avatar must contain AvatarFallback.")
  }
}
