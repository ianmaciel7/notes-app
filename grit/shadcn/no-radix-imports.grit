engine biome(1.0)
language js(typescript, jsx)

JsImport() as $imp where {
  $imp <: r"(?s).*import(?:\s+.*?\s+from)?\s*[\"']@radix-ui\/.*",
  register_diagnostic(span=$imp, message="Do not import from Radix packages directly. Use Base UI primitives or owned shadcn components from '@/components/ui'.")
}
