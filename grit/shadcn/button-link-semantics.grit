engine biome(1.0)
language js(typescript, jsx)

or {
  JsxSelfClosingElement(name=$component, attributes=$attributes) as $button,
  JsxOpeningElement(name=$component, attributes=$attributes) as $button
} where {
  $component <: r"Button",
  $attributes <: contains JsxAttribute() as $attribute,
  $attribute <: r"(?s)render\s*=.*<(a|Link)(\s|/|>)",
  register_diagnostic(span=$attribute, message="Do not render Button as a link. Apply buttonVariants to the anchor or Link so link semantics are preserved.")
}
