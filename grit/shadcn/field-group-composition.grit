engine biome(1.0)
language js(typescript, jsx)

or {
  JsxSelfClosingElement(name=$field_name) as $field,
  JsxOpeningElement(name=$field_name) as $field
} where {
  $field_name <: r"Field",
  $field <: within JsxElement() as $form where {
    $form <: contains JsxOpeningElement(name=$form_name) where {
      $form_name <: r": r"(?s)^\\s*<(?:form|Form)"
    }
  } ,
  not $field <: within JsxElement() as $group where {
    $group <: contains JsxOpeningElement(name=$group_name) where {
      $group_name <: r": r"(?s)^\\s*<FieldGroup"
    }
  } ,
  register_diagnostic(span=$field, message="Field used in a form must be composed inside FieldGroup.")
}
