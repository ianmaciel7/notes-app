engine biome(1.0)
language js(typescript, jsx)

or {
  or {
    JsxSelfClosingElement(name=$item_name) as $item,
    JsxOpeningElement(name=$item_name) as $item
  } where {
    $item_name <: r"(?:SelectItem|SelectLabel)",
    not $item <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^SelectGroup$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$item_name) as $item,
    JsxOpeningElement(name=$item_name) as $item
  } where {
    $item_name <: r"(?:DropdownMenuItem|DropdownMenuLabel)",
    not $item <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^DropdownMenuGroup$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$item_name) as $item,
    JsxOpeningElement(name=$item_name) as $item
  } where {
    $item_name <: r"(?:ContextMenuItem|ContextMenuLabel)",
    not $item <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^ContextMenuGroup$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$item_name) as $item,
    JsxOpeningElement(name=$item_name) as $item
  } where {
    $item_name <: r"MenubarItem",
    not $item <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^MenubarGroup$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$item_name) as $item,
    JsxOpeningElement(name=$item_name) as $item
  } where {
    $item_name <: r"CommandItem",
    not $item <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^CommandGroup$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  },
  or {
    JsxSelfClosingElement(name=$item_name) as $item,
    JsxOpeningElement(name=$item_name) as $item
  } where {
    $item_name <: r"(?:ComboboxItem|ComboboxLabel)",
    not $item <: within JsxElement() as $parent where {
      $parent <: contains ( JsxOpeningElement(name=r"^ComboboxGroup$") as $owner where {
        not $owner <: within JsxElement() as $between where {
          $between <: within $parent ,
          not $between <: $parent
        }
      })
    }
  }
} where {
  register_diagnostic(span=$item, message="This shadcn item must be nested inside its corresponding Group component.")
}
