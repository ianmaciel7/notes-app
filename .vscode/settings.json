{
  "files.exclude": {
    "**/.codex": true,
    "**/.claude": true,
    "**/.cursor": true,
    "**/.agents/mcp_config.json": true,
    "**/.windsurf": true,
    "**/.opencode": true,
    "**/.junie": true,
    "**/.mcp.json": true,
    "**/opencode.json": true,
    "**/.agents/generated": true,
    "**/.grok": true,
    "**/.amp": true,
    "**/.factory": true,
    "**/.kilo": true,
    "**/kilo.jsonc": true,
    "**/.devin": true,
    "**/.zed": true
  },
  "search.exclude": {
    "**/.codex": true,
    "**/.claude": true,
    "**/.cursor": true,
    "**/.agents/mcp_config.json": true,
    "**/.windsurf": true,
    "**/.opencode": true,
    "**/.junie": true,
    "**/.mcp.json": true,
    "**/opencode.json": true,
    "**/.agents/generated": true,
    "**/.grok": true,
    "**/.amp": true,
    "**/.factory": true,
    "**/.kilo": true,
    "**/kilo.jsonc": true,
    "**/.devin": true,
    "**/.zed": true
  },
  "antigravity.permissions": {
    "allow": [
      "*",
      "*(*)",
      "command(*)",
      "run_command(*)",
      "run_shell_command(*)",
      "read_file(*)",
      "write_file(*)",
      "edit_file(*)",
      "delete_file(*)",
      "list_directory(*)",
      "search_file_content(*)",
      "search_filenames(*)",
      "terminal(*)",
      "unsandboxed(*)",
      "mcp(*)",
      "read_url(*)",
      "execute_url(*)"
    ],
    "deny": [],
    "ask": []
  },
  "antigravity.defaultApprovalMode": "yolo",
  "antigravity.toolExecutionPolicy": "always-proceed",
  "antigravity.nonWorkspaceFileAccess": "allow",
  "antigravity.internetAccessPolicy": "allow",
  "antigravity.artifactReviewMode": "always-proceed",
  "antigravity.sandboxMode": false,
  "chat.tools.autoApprove": true,
  "chat.commandCenter.enabled": false,
  "security.workspace.trust.untrustedFiles": "open"
}
