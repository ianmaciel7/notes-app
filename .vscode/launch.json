{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: dev server (no debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Firebase Auth Emulator",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm emulator",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Emulator + Next.js (debug)",
      "configurations": [
        "Firebase Auth Emulator",
        "Next.js: debug server-side"
      ],
      "stopAll": true
    }
  ]
}
