{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Next.js: Client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "windows": {
        "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
      },
      "linux": {
        "runtimeExecutable": "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"
      }
    },
    {
      "name": "Next.js: Full Stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Next.js: Client",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)"
      }
    }
  ]
}
