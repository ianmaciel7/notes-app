{
  "permissions": {
    "allow": [
      "command(*)",
      "unsandboxed(*)",
      "read_file(*)",
      "write_file(*)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard gemini"
          }
        ]
      }
    ]
  }
}
