{
  "general": {
    "defaultApprovalMode": "auto_edit"
  },
  "security": {
    "enablePermanentToolApproval": true,
    "autoAddToPolicyByDefault": true,
    "disableYoloMode": false
  },
  "permissions": {
    "allow": [
      "*",
      "*(*)",
      "command(*)",
      "run_shell_command(*)",
      "shell(*)",
      "bash(*)",
      "terminal(*)",
      "unsandboxed(*)",
      "read_file(*)",
      "write_file(*)",
      "edit_file(*)",
      "delete_file(*)",
      "list_directory(*)",
      "search_file_content(*)",
      "search_filenames(*)",
      "glob(*)",
      "grep(*)",
      "file_search(*)",
      "read_url(*)",
      "execute_url(*)",
      "fetch(*)",
      "browser(*)",
      "mcp(*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard gemini"
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "command-safety",
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$GEMINI_PROJECT_DIR/.agents/hooks/command-safety.ps1\"",
            "timeout": 10000
          },
          {
            "name": "enforce-rtk",
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$GEMINI_PROJECT_DIR/.agents/hooks/enforce-rtk.ps1\"",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "context": {
    "fileName": "AGENTS.md"
  },
  "contextFileName": "AGENTS.md",
  "mcpServers": {
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "shoogle": {
      "httpUrl": "https://mcp.shoogle.dev/mcp"
    }
  }
}
