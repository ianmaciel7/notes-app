{
  "general": {
    "defaultApprovalMode": "yolo"
  },
  "security": {
    "enablePermanentToolApproval": true,
    "autoAddToPolicyByDefault": true,
    "disableYoloMode": false
  },
  "permissions": {
    "allow": [
      "*",
      "*(*)",
      "command(*)",
      "run_shell_command(*)",
      "run_command",
      "run_command(*)",
      "write_to_file",
      "write_to_file(*)",
      "replace_file_content",
      "replace_file_content(*)",
      "view_file",
      "view_file(*)",
      "call_mcp_tool",
      "call_mcp_tool(*)",
      "invoke_subagent",
      "invoke_subagent(*)",
      "manage_subagents",
      "manage_subagents(*)",
      "manage_task",
      "manage_task(*)",
      "schedule",
      "schedule(*)",
      "ask_question",
      "ask_question(*)",
      "generate_image",
      "generate_image(*)",
      "read_url_content",
      "read_url_content(*)",
      "search_web",
      "search_web(*)",
      "shell(*)",
      "bash(*)",
      "terminal(*)",
      "unsandboxed(*)",
      "read_file(*)",
      "write_file(*)",
      "edit_file(*)",
      "delete_file(*)",
      "list_directory(*)",
      "search_file_content(*)",
      "search_filenames(*)",
      "glob(*)",
      "grep(*)",
      "file_search(*)",
      "read_url(*)",
      "execute_url(*)",
      "fetch(*)",
      "browser(*)",
      "mcp(*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard gemini"
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "command-safety",
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$GEMINI_PROJECT_DIR/.agents/hooks/command-safety.ps1\"",
            "timeout": 10000
          },
          {
            "name": "enforce-rtk",
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$GEMINI_PROJECT_DIR/.agents/hooks/enforce-rtk.ps1\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "post-edit-check",
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$GEMINI_PROJECT_DIR/.agents/hooks/post-edit-check.ps1\"",
            "timeout": 30000
          }
        ]
      }
    ]
  },
  "context": {
    "fileName": "AGENTS.md"
  },
  "contextFileName": "AGENTS.md",
  "mcpServers": {
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "firebase": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "firebase",
        "mcp",
        "--only",
        "firestore,auth",
        "--project",
        "demo-recall"
      ]
    },
    "shoogle": {
      "httpUrl": "https://mcp.shoogle.dev/mcp"
    }
  }
}
