# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/temp
temp/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# AI agent vendor-specific local configuration
# The repository uses AGENTS.md + .agents/ as the canonical
# vendor-neutral agent configuration.
.agent/
.codex/
.gemini/

# local agent/context indexes and scratch state
/.playwright-mcp/
.codebase-memory/
.codegraph/
.codegraph-*/
.context-mode/
.serena/

# Graphify repository artifacts are versioned intentionally; local runtime,
# cost, cache, and intermediate extraction state stays out of Git.
/graphify-out/*
!/graphify-out/
!/graphify-out/graph.json
!/graphify-out/graph.html
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/manifest.json
!/graphify-out/.graphify_root
/graphify-out/.graphify_python
/graphify-out/cost.json
/graphify-out/cache/
/graphify-out/reflections/
/graphify-out/*/
/graphify-out/.graphify_*.json
/graphify-out/.graphify_*.sig

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
