{
  "schemaVersion": 4,
  "instructions": {
    "path": "AGENTS.md"
  },
  "integrations": {
    "enabled": [
      "codex",
      "claude",
      "claude_desktop",
      "gemini",
      "antigravity",
      "cursor",
      "grok"
    ],
    "options": {
      "cursorAutoApprove": true,
      "antigravityGlobalSync": true,
      "claudeScope": "project",
      "copilotCliPath": ".mcp.json"
    }
  },
  "syncMode": "source-only",
  "mcp": {
    "servers": {
      "filesystem": {
        "label": "Filesystem",
        "description": "Read and write files in the current project",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "${PROJECT_ROOT}"
        ],
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      },
      "fetch": {
        "label": "Fetch",
        "description": "HTTP fetching and scraping helpers",
        "transport": "stdio",
        "command": "uvx",
        "args": [
          "mcp-server-fetch"
        ],
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        },
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      },
      "git": {
        "label": "Git",
        "description": "Repository-aware git operations",
        "transport": "stdio",
        "command": "uvx",
        "args": [
          "mcp-server-git",
          "--repository",
          "${PROJECT_ROOT}"
        ],
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        },
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      },
      "github": {
        "label": "GitHub",
        "description": "Official GitHub MCP Server",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "targets": [
          "codex",
          "claude",
          "antigravity",
          "cursor"
        ],
        "enabled": true
      },
      "serena": {
        "label": "Serena",
        "description": "Serena code navigation and symbolic editing MCP server",
        "transport": "stdio",
        "command": "serena",
        "args": [
          "start-mcp-server"
        ],
        "targets": [
          "antigravity",
          "cursor",
          "claude"
        ],
        "enabled": true
      },
      "graphify": {
        "label": "Graphify",
        "description": "Codebase knowledge graph querying MCP server",
        "transport": "stdio",
        "command": "graphify-mcp",
        "args": [],
        "targets": [
          "antigravity",
          "cursor",
          "claude"
        ],
        "enabled": true
      },
      "playwright": {
        "label": "Playwright",
        "description": "Playwright browser automation MCP server",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp"
        ],
        "targets": [
          "antigravity",
          "cursor"
        ],
        "enabled": true
      },
      "firebase": {
        "label": "Firebase",
        "description": "Firebase CLI local emulator and project MCP server",
        "transport": "stdio",
        "command": "pnpm",
        "args": [
          "dlx",
          "firebase-tools",
          "mcp"
        ],
        "targets": [
          "antigravity",
          "cursor"
        ],
        "enabled": true
      },
      "nextjs": {
        "label": "Next.js",
        "description": "Next.js DevTools and agent MCP server",
        "transport": "stdio",
        "command": "pnpm",
        "args": [
          "exec",
          "next",
          "experimental-mcp"
        ],
        "targets": [
          "antigravity",
          "cursor"
        ],
        "enabled": true
      }
    }
  },
  "workspace": {
    "vscode": {
      "hideGenerated": true,
      "hiddenPaths": [
        "**/.codex",
        "**/.claude",
        "**/.gemini",
        "**/.cursor",
        "**/.antigravity",
        "**/.agents/mcp_config.json",
        "**/.windsurf",
        "**/.opencode",
        "**/.junie",
        "**/.mcp.json",
        "**/opencode.json",
        "**/.agents/generated",
        "**/.grok",
        "**/.amp",
        "**/.factory",
        "**/.kilo",
        "**/kilo.jsonc",
        "**/.devin",
        "**/.zed"
      ]
    }
  },
  "lastSync": null,
  "lastSyncSourceHash": null
}
