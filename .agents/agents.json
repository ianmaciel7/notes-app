{
  "schemaVersion": 4,
  "instructions": {
    "path": "AGENTS.md"
  },
  "integrations": {
    "enabled": [
      "claude",
      "antigravity",
      "gemini",
      "codex"
    ],
    "options": {
      "cursorAutoApprove": true,
      "antigravityGlobalSync": true,
      "claudeScope": "project",
      "copilotCliPath": ".mcp.json"
    }
  },
  "syncMode": "source-only",
  "mcp": {
    "servers": {
      "filesystem": {
        "label": "Filesystem",
        "description": "Read and write files in the current project",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "${PROJECT_ROOT}"
        ],
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": false
      },
      "fetch": {
        "label": "Fetch",
        "description": "HTTP fetching and scraping helpers",
        "transport": "stdio",
        "command": "uvx",
        "args": [
          "mcp-server-fetch"
        ],
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        },
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      },
      "git": {
        "label": "Git",
        "description": "Repository-aware git operations",
        "transport": "stdio",
        "command": "uvx",
        "args": [
          "mcp-server-git",
          "--repository",
          "${PROJECT_ROOT}"
        ],
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        },
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": false
      },
      "shoogle": {
        "transport": "http",
        "enabled": true,
        "description": "Shoogle shadcn/ui registry search engine",
        "url": "https://mcp.shoogle.dev/mcp"
      },
      "firebase": {
        "label": "Firebase",
        "description": "Official Firebase MCP server (firestore, auth) for this project's emulator/live data",
        "transport": "stdio",
        "command": "pnpm",
        "args": [
          "exec",
          "firebase",
          "mcp",
          "--only",
          "firestore,auth",
          "--project",
          "demo-recall"
        ],
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      }
    }
  },
  "workspace": {
    "vscode": {
      "hideGenerated": true,
      "hiddenPaths": [
        "**/.codex",
        "**/.claude",
        "**/.gemini",
        "**/.cursor",
        "**/.antigravity",
        "**/.agents/mcp_config.json",
        "**/.windsurf",
        "**/.opencode",
        "**/.junie",
        "**/.mcp.json",
        "**/opencode.json",
        "**/.agents/generated",
        "**/.grok",
        "**/.amp",
        "**/.factory",
        "**/.kilo",
        "**/kilo.jsonc",
        "**/.devin",
        "**/.zed"
      ]
    }
  },
  "lastSync": null,
  "lastSyncSourceHash": null,
  "activeProfile": null
}
