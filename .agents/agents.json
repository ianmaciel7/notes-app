{
  "schemaVersion": 4,
  "instructions": {
    "path": "AGENTS.md"
  },
  "integrations": {
    "enabled": ["codex", "antigravity", "claude"],
    "options": {
      "cursorAutoApprove": true,
      "antigravityGlobalSync": true,
      "claudeScope": "project",
      "copilotCliPath": ".mcp.json"
    }
  },
  "syncMode": "source-only",
  "mcp": {
    "servers": {
      "filesystem": {
        "label": "Filesystem",
        "description": "Read and write files in the current project",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "${PROJECT_ROOT}"
        ],
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      },
      "fetch": {
        "label": "Fetch",
        "description": "HTTP fetching and scraping helpers",
        "transport": "stdio",
        "command": "uvx",
        "args": ["mcp-server-fetch"],
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        },
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      },
      "git": {
        "label": "Git",
        "description": "Repository-aware git operations",
        "transport": "stdio",
        "command": "uvx",
        "args": ["mcp-server-git", "--repository", "${PROJECT_ROOT}"],
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        },
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf",
          "opencode",
          "junie",
          "grok",
          "amp",
          "droid",
          "kilo",
          "devin",
          "zed",
          "goose"
        ],
        "enabled": true
      },
      "serena": {
        "transport": "stdio",
        "enabled": true,
        "targets": ["codex", "antigravity"],
        "description": "Semantic code retrieval and editing for the current project",
        "command": "uvx",
        "args": [
          "--from",
          "git+https://github.com/oraios/serena@7a2968335f2198b966864de1ce3655c8e485a653",
          "serena",
          "start-mcp-server",
          "--context=codex",
          "--project-from-cwd"
        ]
      },
      "graphify": {
        "transport": "stdio",
        "enabled": true,
        "targets": ["codex", "antigravity", "claude"],
        "description": "Code knowledge graph, architecture analysis, and call-path tracing",
        "command": "graphify",
        "args": ["serve", "--project", "${PROJECT_ROOT}"]
      },
      "shoogle": {
        "transport": "http",
        "enabled": true,
        "url": "https://mcp.shoogle.dev/mcp",
        "description": "Shoogle MCP server for searching community shadcn registries",
        "targets": [
          "codex",
          "claude",
          "claude_desktop",
          "gemini",
          "copilot_vscode",
          "copilot_cli",
          "cursor",
          "antigravity",
          "windsurf"
        ]
      }
    }
  },
  "workspace": {
    "vscode": {
      "hideGenerated": true,
      "hiddenPaths": [
        "**/.codex",
        "**/.claude",
        "**/.cursor",
        "**/.agents/mcp_config.json",
        "**/.windsurf",
        "**/.opencode",
        "**/.junie",
        "**/.mcp.json",
        "**/opencode.json",
        "**/.agents/generated",
        "**/.grok",
        "**/.amp",
        "**/.factory",
        "**/.kilo",
        "**/kilo.jsonc",
        "**/.devin",
        "**/.zed"
      ]
    }
  },
  "lastSync": null,
  "lastSyncSourceHash": null,
  "activeProfile": null
}
