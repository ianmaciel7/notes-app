{
  "command-safety": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/command-safety.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enforce-rtk": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/enforce-rtk.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
