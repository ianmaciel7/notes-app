{
  "quality-after-edit": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm tsx scripts/quality/agent-hook.ts antigravity-post-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "quality-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "pnpm tsx scripts/quality/agent-hook.ts antigravity-stop",
        "timeout": 150
      }
    ]
  }
}
