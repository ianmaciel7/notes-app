{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.agents",
      "!src/components/ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended",
      "project": "recommended",
      "types": "recommended"
    }
  },
  "plugins": [
    "./grit/shadcn/base-ui-no-as-child.grit",
    "./grit/shadcn/base-ui-api.grit",
    "./grit/shadcn/required-accessible-parts.grit",
    "./grit/shadcn/group-composition.grit",
    "./grit/shadcn/input-group-composition.grit",
    "./grit/shadcn/button-state.grit",
    "./grit/shadcn/tabs-composition.grit",
    "./grit/shadcn/button-link-semantics.grit",
    "./grit/shadcn/button-icon.grit",
    "./grit/shadcn/field-validation.grit"
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
