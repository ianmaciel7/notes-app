{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "emulator": "firebase emulators:start --only auth,firestore --import=./.firebase/seeds --export-on-exit=./.firebase/seeds",
    "emulator:start": "firebase emulators:start --only auth,firestore",
    "lint": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check:duplication": "jscpd --config .jscpd.json src",
    "lint:actions": "actionlint",
    "deps:check": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "check:types": "tsc --noEmit",
    "check:lint": "biome ci src scripts .agents/evals package.json .dependency-cruiser.cjs",
    "check:floor": "node scripts/guards/floor-guard.mjs",
    "check:rsc": "node scripts/guards/guard-rsc-boundaries.mjs",
    "check:props": "node scripts/guards/guard-component-props.mjs",
    "check:security": "pnpm audit --audit-level high",
    "check:osv": "osv-scanner scan source --config osv-scanner.toml --recursive .",
    "check:agents": "pnpm run .agents:sync && node scripts/tooling/run-agents-cli.mjs sync --check",
    "check:fast": "pnpm run check:types && pnpm run check:lint && pnpm run check:rsc && pnpm run check:naming && pnpm run check:props && pnpm run deps:check && pnpm run check:floor && pnpm run test && pnpm run check:duplication",
    "knip": "knip",
    "lighthouse": "pnpm build && lhci autorun",
    "format": "biome format --write",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "ladle:preview": "ladle preview",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "check:docs": "node scripts/verify/verify-control-docs.mjs",
    "test:harness": "node --test .agents/evals/lib.test.mjs",
    "check:ci": "pnpm run check:fast && pnpm run verify:docs && pnpm run test:harness && pnpm run test:guards && pnpm run test:coverage && pnpm run check:agents && pnpm run build",
    "eval:codex": "node .agents/evals/run.mjs --provider codex",
    "eval:antigravity": "node .agents/evals/run.mjs --provider antigravity",
    "verify:health": "node scripts/verify/verify-health.mjs",
    "harness:health": "pnpm run check:ci && pnpm run knip && pnpm run test:mutation && pnpm run check:security",
    "test:ai-tooling": "node scripts/verify/verify-ai-tooling.mjs",
    "verify:docs": "node scripts/verify/verify-docs.mjs",
    "test:guards": "node --test scripts/guards/floor-guard.test.mjs scripts/hooks/hooks.test.mjs scripts/verify/verify-docs.test.mjs scripts/guards/guard-rsc-boundaries.test.mjs scripts/guards/guard-component-props.test.mjs",
    "check:naming": "node scripts/guards/guard-component-naming.mjs",
    ".agents:sync": "node scripts/tooling/run-agents-cli.mjs sync",
    "eval:compare": "node .agents/evals/compare.mjs"
  },
  "lint-staged": {
    "*.{cjs,css,json,jsonc,js,mjs,ts,tsx}": "biome check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.13.1",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/inter": "5.3.0",
    "@ladle/react": "5.1.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.50.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.4.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jscpd": "^5.3.1",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
