{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:actions": "actionlint",
    "deps:check": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "check:types": "tsc --noEmit",
    "check:lint": "biome check .dependency-cruiser.cjs scripts/floor-guard.mjs package.json",
    "check:floor": "node scripts/floor-guard.mjs",
    "check:security": "pnpm audit --audit-level high",
    "check:osv": "osv-scanner scan source --config osv-scanner.toml --recursive .",
    "check:fast": "pnpm run check:types && pnpm run check:lint && pnpm run deps:check && pnpm run check:floor",
    "knip": "pnpm dlx knip",
    "lighthouse": "pnpm build && lhci autorun",
    "format": "biome format --write",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "ladle:preview": "ladle preview",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{cjs,css,json,jsonc,js,mjs,ts,tsx}": "biome check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.13.1",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/inter": "5.3.0",
    "@ladle/react": "5.1.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.20.0"
}
