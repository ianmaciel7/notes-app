{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "biome:ci": "biome ci .",
    "format:check": "biome format package.json biome.json",
    "lint": "biome lint src scripts tests",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "complexity": "node scripts/check-complexity.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=60 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:parity": "playwright test tests/e2e/workspace-parity.spec.ts",
    "audit:parity": "node scripts/audit-workspace-parity.mjs",
    "audit:shadcn": "node scripts/audit-shadcn-contracts.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm audit:shadcn && pnpm complexity && pnpm typegen && pnpm typecheck && pnpm test:coverage && pnpm build",
    "graphify:knowledge": "node ./scripts/graphify-ingest-legacy.mjs",
    "graphify:knowledge:build": "node ./scripts/graphify-ingest-legacy.mjs --build",
    "graphify:install": "node ./scripts/graphify-install.mjs",
    "graphify:build": "graphify extract . --code-only --output . && graphify cluster-only .",
    "graphify:update:code": "graphify extract . --code-only --output . --no-cluster && graphify cluster-only . --graph graphify-out/graph.json --no-viz --no-label",
    "graphify:status": "graphify god-nodes"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@floating-ui/dom": "1.8.0",
    "@shadcn/react": "^0.3.0",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-bubble-menu": "3.30.2",
    "@tiptap/extension-drag-handle-react": "3.30.2",
    "@tiptap/extension-placeholder": "3.30.2",
    "@tiptap/extension-task-item": "3.30.2",
    "@tiptap/extension-task-list": "3.30.2",
    "@tiptap/markdown": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "@tiptap/suggestion": "3.30.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.3.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.20.0"
}
