{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:changed": "biome check --changed --since=origin/main",
    "check:types": "next typegen && tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "firebase emulators:exec --project demo-notes-app --only auth --import .firebase/seeds \"playwright test\"",
    "emulator": "firebase emulators:start --project demo-notes-app --only auth --import .firebase/seeds",
    "emulators:seed": "firebase emulators:exec --project demo-notes-app --only auth --export-on-exit .firebase/seeds \"node scripts/create-auth-emulator-seed.mjs\"",
    "test:mutation": "stryker run",
    "check:deps": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "check:unused": "knip",
    "check:duplication": "jscpd --config .jscpd.json src",
    "check:health": "fallow audit",
    "check:size": "size-limit",
    "lint:spelling": "cspell \"**/*.{ts,tsx,md}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check:security": "pnpm audit --audit-level high",
    "verify:agents": "agents sync --check",
    "ci:wait": "node scripts/wait-for-ci.mjs",
    "ci:check-paths": "node scripts/wait-for-ci.mjs --check-paths",
    "verify:fast": "pnpm run lint && pnpm run check:types && pnpm run test && pnpm run check:deps && pnpm run lint:spelling",
    "verify:changed": "pnpm run lint:changed && pnpm run check:types && pnpm run test:changed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx,css,json}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@firebase-oss/ui-translations": "7.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.8.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "^10.3.6",
    "dependency-cruiser": "^18.5.0",
    "fallow": "^3.31.0",
    "firebase-admin": "13.4.0",
    "firebase-tools": "15.0.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "size-limit": "^14.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
