{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --kill-others-on-fail --names next,ladle,firebase \"pnpm dev\" \"pnpm ladle\" \"pnpm firebase:emulators\"",
    "firebase:emulators": "npx -y firebase-tools@latest emulators:start --project demo-notes-app",
    "firebase:emulators:exec": "npx -y firebase-tools@latest emulators:exec --project demo-notes-app \"node -e 1\"",
    "build": "next build",
    "start": "next start",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "ladle:preview": "ladle preview",
    "lint": "biome check",
    "test": "vitest run",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@ladle/react": "^5.1.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.20.0"
}
