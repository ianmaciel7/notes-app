{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "biome:ci": "biome ci .",
    "biome:fix": "biome check --write .",
    "biome:staged": "biome check --write --staged",
    "biome:changed": "biome check --changed",
    "lint": "biome ci --formatter-enabled=false .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false .",
    "format": "biome format --write .",
    "complexity": "node scripts/check-complexity.mjs",
    "agent-hooks:install": "lefthook install",
    "agent-hooks:validate": "lefthook run agent-validate",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "graphify:check": "node scripts/check-graphify.mjs",
    "graphify:update": "graphify update .",
    "verify": "pnpm biome:ci && pnpm complexity && pnpm typegen && pnpm typecheck && pnpm test:coverage && pnpm graphify:check && pnpm build"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.0.1",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
