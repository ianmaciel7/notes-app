{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "agentation": "set AGENTATION_STORE=memory&& node node_modules/agentation-mcp/dist/cli.js server",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "complexity:check": "node scripts/quality/check-complexity.mjs",
    "deps:check": "depcruise --config dependency-cruiser.config.cjs src",
    "unused:check": "knip",
    "ladle:dev": "ladle serve",
    "ladle:build": "ladle build",
    "ladle:preview": "ladle preview",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "hooks:test": "vitest run src/tooling/quality-hooks.test.ts",
    "quality:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm complexity:check",
    "quality": "pnpm quality:fast && pnpm deps:check && pnpm unused:check && pnpm test:coverage && pnpm hooks:test",
    "verify": "pnpm quality && pnpm build && pnpm test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,yml,yaml,md,mdc}": "biome check --no-errors-on-unmatched"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@blocknote/core": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@blocknote/shadcn": "^0.54.2",
    "@floating-ui/dom": "1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-drag-handle-react": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-task-item": "3.31.0",
    "@tiptap/extension-task-list": "3.31.0",
    "@tiptap/markdown": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "@tiptap/suggestion": "3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "cuelume": "^0.2.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "input-otp": "^1.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.39.0",
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "dependency-cruiser": "^18.2.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typhonjs-escomplex": "^0.1.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
