rules_version = '2';

// ===============================================================
// ExamPrep Platform Security Rules
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isValidNotePayload(data) {
      let allowedFields = ['title', 'content', 'createdAt', 'updatedAt', 'tags', 'questionId', 'examId', 'userId', 'noteId'];
      return data.keys().hasOnly(allowedFields)
        && (!('title' in data) || (data.title is string && data.title.size() >= 1 && data.title.size() <= 200))
        && data.content is string
        && data.content.size() <= 50000
        && (!('questionId' in data) || (data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 200))
        && (!('examId' in data) || (data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 200))
        && (!('userId' in data) || (data.userId is string && data.userId == request.auth.uid))
        && (!('noteId' in data) || (data.noteId is string && data.noteId.size() >= 1 && data.noteId.size() <= 200))
        && data.updatedAt is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10));
    }

    function isValidNoteCreate(data) {
      return data.content is string
        && data.updatedAt is timestamp
        && isValidNotePayload(data);
    }

    function isValidNoteUpdate(data) {
      return data.content is string
        && data.updatedAt is timestamp
        && isValidNotePayload(data)
        && (!('createdAt' in resource.data) || !('createdAt' in data) || data.createdAt == resource.data.createdAt);
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Exam Catalog and Questions:
    // Authenticated users can read exam metadata and questions.
    // Writes are restricted strictly to administrators.
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // Space-scoped typed objects and relations are server-only.
    // Client SDK reads/writes are denied; access is mediated by Firebase Admin after server authorization.
    match /spaces/{spaceId} {
      allow read, write: if false;

      match /{allSubpaths=**} {
        allow read, write: if false;
      }
    }

    // User Scoped Data:
    match /users/{userId} {
      // User-scoped spaces, attempts, question memory, and review events are server-only.
      match /spaces/{spaceId}/{document=**} {
        allow read, write: if false;
      }

      // User-scoped UI and study preferences
      match /settings/{settingId} {
        allow read: if isOwner(userId) && settingId == 'preferences';
        allow create, update: if isOwner(userId)
          && settingId == 'preferences'
          && request.resource.data.keys().hasOnly(['assessmentViewMode'])
          && request.resource.data.assessmentViewMode in ['continuous', 'focus'];
      }

      // User-scoped exam progress aggregates
      match /examProgress/{examId} {
        allow read, write: if isOwner(userId);

        // Subcollection for per-question progress details
        match /questionProgress/{questionId} {
          allow read, write: if isOwner(userId);
        }
      }

      // User study notes linked to questions and exams
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNoteCreate(request.resource.data);
        allow update: if isOwner(userId) && isValidNoteUpdate(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
