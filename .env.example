# Local environment values.
# Do not commit real secrets.

# Stitch MCP auth. Use either STITCH_API_KEY or Google Cloud ADC.
STITCH_API_KEY=
STITCH_USE_SYSTEM_GCLOUD=false

# Authenticated browser MCP.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# GitHub MCP auth.
GITHUB_MCP_TOKEN=
GITHUB_PAT_TOKEN=

# Server-only Gemini configuration.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GEMINI_MODEL=

